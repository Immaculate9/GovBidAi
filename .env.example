# Formspree — create forms at https://formspree.io (set notification emails in dashboard)
NEXT_PUBLIC_FORMSPREE_CONTACT_FORM_ID=
NEXT_PUBLIC_FORMSPREE_ACCESS_FORM_ID=

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# Dev-only test keys (always pass): site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Copy this file to .env.local and fill in real values. Never commit .env.local.
